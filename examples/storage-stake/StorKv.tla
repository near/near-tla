---------------------------- MODULE StorKv ----------------------------
(***************************************************************************)
(* Measured storage bytes, generated by conformance/ (bin `calibrate`,     *)
(* --stor): do not edit by hand.  bytes = base + per * size: what a        *)
(* successful receipt adds to its receiver's storage_usage (negative:      *)
(* frees), read before and after the receipt in near-contract-sim, which   *)
(* runs nearcore's Runtime::apply.  Each flow ran once, at the top of its  *)
(* grid (bytes do not depend on gas), and every measurement lies on its    *)
(* key's line exactly.  Read with OStorKey (modules/NearAsync.tla).        *)
(*                                                                         *)
(* Provenance:                                                             *)
(*   sim rev          29e909033bb59eab792dee136e9d02870488bc3e             *)
(*   nearcore         2.14.0-rc.5 (b7b4737cab46f17a6daa2ed694d7aebbd204363a)*)
(*   protocol version 88                                                   *)
(*   p-probe.near: probe.wasm                                              *)
(*     conformance/probes/probe (near-sdk 5.29.1)                          *)
(*     sha256 4c8fa4fa1c927ccae31f871049e9cafb                             *)
(*            dc44a8edc6e0eb690d5290f027c6cf77                             *)
(*   ft-probe.near: ft.wasm                                                *)
(*     conformance/probes/ft (near-contract-standards 5.29.1)              *)
(*     sha256 2d356b2df7a4cb11edcefe41dea4ce93                             *)
(*            3f50bbe45203b411a685cb22d0f46b0a                             *)
(*   wnear-probe.near: wrap.wasm                                           *)
(*     conformance/probes/wrap (near-contract-standards 5.29.1)            *)
(*     sha256 fe61c212e119387f479195e64098ceea                             *)
(*            cbed184cac9ef07728172d2cac084b2d                             *)
(* command: calibrate --flows flows/storage.toml --stor --group p:Kv:app   *)
(*     --tla ../examples/storage-stake/StorKv.tla --module StorKv --notes  *)
(*     flows/storkv.notes                                                  *)
(* flows: storage.toml sha256                                              *)
(*     17853ec204f5cf785a6e51b9dec4d28a071dc4b0c2a5a4f189597d034b305997    *)
(* 20 flows, each run once at the top of its grid; 20 call receipts        *)
(* size of p-probe.near.put: arg_len:key+value                             *)
(*                                                                         *)
(* Table: KvStorBytes(app) for a contract whose put(key, value) writes     *)
(* value under key with env::storage_write (the generic probe, measured on *)
(* p-probe.near).  size: len(key) + len(value) in bytes.  put/new: a new   *)
(* key, key + value + 40 bytes (40: nearcore's per-record overhead,        *)
(* storage_num_extra_bytes_record); put/same: an overwrite with a value of *)
(* the same length, 0.  Used by examples/storage-stake (Vault.tla).        *)
(* Probe contracts built with --cfg near (probes/build.sh).                *)
(* Bytes depend on the contract's code and state: recalibrate for a real   *)
(* deployment (conformance/README.md).                                     *)
(***************************************************************************)
EXTENDS Integers, Sequences, TLC

KvStorBytes(app) ==
    app \o ".put/new" :> [base |-> 40, per |-> 1] @@  \* 3 pts; sizes 2-102; put_new_0 put_new_100 put_new_key20
    app \o ".put/same" :> [base |-> 0, per |-> 0]  \* 1 pt; size 5; put_same
=============================================================================
