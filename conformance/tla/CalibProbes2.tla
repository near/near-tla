---------------------------- MODULE CalibProbes2 ----------------------------
(***************************************************************************)
(* Calibrated gas tables, generated by conformance/ (bin `calibrate`):     *)
(* do not edit by hand.  Units: Ggas (1 Tgas = 1000); burn = base + per *  *)
(* size.  Measured in near-contract-sim, which runs nearcore's             *)
(* Runtime::apply.  Every burn measured is at or below base + per * size   *)
(* (per: the fitted slope, rounded; base and exec fees rounded up), so     *)
(* the tables never understate what they were measured on; "max            *)
(* residual" is the most a key overstates one measurement (Ggas).          *)
(*                                                                         *)
(* Provenance:                                                             *)
(*   sim rev          29e909033bb59eab792dee136e9d02870488bc3e             *)
(*   nearcore         2.14.0-rc.5 (b7b4737cab46f17a6daa2ed694d7aebbd204363a)*)
(*   protocol version 88                                                   *)
(*   p-probe.near: probe.wasm                                              *)
(*     conformance/probes/probe (near-sdk 5.29.1)                          *)
(*     sha256 4c8fa4fa1c927ccae31f871049e9cafb                             *)
(*            dc44a8edc6e0eb690d5290f027c6cf77                             *)
(*   q-probe.near: probe.wasm                                              *)
(*     conformance/probes/probe (near-sdk 5.29.1)                          *)
(*     sha256 4c8fa4fa1c927ccae31f871049e9cafb                             *)
(*            dc44a8edc6e0eb690d5290f027c6cf77                             *)
(*   z-probe.near: probe2.wasm                                             *)
(*     conformance/probes/probe2 (near-sdk 5.29.1)                         *)
(*     sha256 665516c481ffbb878cc1eb436bb592f0                             *)
(*            3f550c2e0ac12af2b4ab9a284d3a993a                             *)
(* command: calibrate --flows flows/probes2.toml --from-data --tla         *)
(*     tla/CalibProbes2.tla --prefix Probe2                                *)
(* flows: probes2.toml sha256                                              *)
(*     bd0381c50c7281c8ec97be926bc4edf11d4f17d3e948c327183f786d13588d68    *)
(* grid: standard (1313 points), 22 flows                                  *)
(* split check: 48732 children, 0 mismatches; 0 per action                 *)
(*                                                                         *)
(* Burns depend on the contract's code and state: recalibrate for a real   *)
(* deployment (conformance/README.md).                                     *)
(***************************************************************************)
EXTENDS TLC, Sequences

