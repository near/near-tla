---------------------------- MODULE CalibProbes ----------------------------
(***************************************************************************)
(* Calibrated gas tables, generated by conformance/ (bin `calibrate`):     *)
(* do not edit by hand.  Units: Ggas (1 Tgas = 1000); burn = base + per *  *)
(* size.  Measured in near-contract-sim, which runs nearcore's             *)
(* Runtime::apply.  Every burn measured is at or below base + per * size   *)
(* (per: the fitted slope, rounded; base and exec fees rounded up), so     *)
(* the tables never understate what they were measured on; "max            *)
(* residual" is the most a key overstates one measurement (Ggas).          *)
(*                                                                         *)
(* Provenance:                                                             *)
(*   sim rev          29e909033bb59eab792dee136e9d02870488bc3e             *)
(*   nearcore         2.14.0-rc.5 (b7b4737cab46f17a6daa2ed694d7aebbd204363a)*)
(*   protocol version 88                                                   *)
(*   p-probe.near: probe.wasm                                              *)
(*     conformance/probes/probe (near-sdk 5.29.1)                          *)
(*     sha256 4c8fa4fa1c927ccae31f871049e9cafb                             *)
(*            dc44a8edc6e0eb690d5290f027c6cf77                             *)
(*   q-probe.near: probe.wasm                                              *)
(*     conformance/probes/probe (near-sdk 5.29.1)                          *)
(*     sha256 4c8fa4fa1c927ccae31f871049e9cafb                             *)
(*            dc44a8edc6e0eb690d5290f027c6cf77                             *)
(*   y-probe.near: async_probe.wasm                                        *)
(*     conformance/probes/async-probe (near-sdk 5.29.1)                    *)
(*     sha256 f31b5b1083dcc1d204ed6787ad71d0cf                             *)
(*            d26fe1c0bd364c15008a2f2754035fbc                             *)
(*   ft-probe.near: ft.wasm                                                *)
(*     conformance/probes/ft (near-contract-standards 5.29.1)              *)
(*     sha256 2d356b2df7a4cb11edcefe41dea4ce93                             *)
(*            3f50bbe45203b411a685cb22d0f46b0a                             *)
(*   wnear-probe.near: wrap.wasm                                           *)
(*     conformance/probes/wrap (near-contract-standards 5.29.1)            *)
(*     sha256 fe61c212e119387f479195e64098ceea                             *)
(*            cbed184cac9ef07728172d2cac084b2d                             *)
(* command: calibrate --flows flows/probes.toml --from-data --merge-accts  *)
(*     ft_probe,wnear_probe --batch-actions --tla tla/CalibProbes.tla      *)
(*     --prefix Probe                                                      *)
(* flows: probes.toml sha256                                               *)
(*     4575b54dcb586a81c34d462e60238ef9d2c8413170eb06870430e00d63b06734    *)
(* grid: standard (1313 points), 74 flows                                  *)
(* split check: 108986 children, 0 mismatches; 7408 per action             *)
(*                                                                         *)
(* Burns depend on the contract's code and state: recalibrate for a real   *)
(* deployment (conformance/README.md).                                     *)
(***************************************************************************)
