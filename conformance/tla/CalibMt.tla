---------------------------- MODULE CalibMt ----------------------------
(***************************************************************************)
(* Calibrated gas tables, generated by conformance/ (bin `calibrate`):     *)
(* do not edit by hand.  Units: Ggas (1 Tgas = 1000); burn = base + per *  *)
(* size.  Measured in near-contract-sim, which runs nearcore's             *)
(* Runtime::apply.  Every burn measured is at or below base + per * size   *)
(* (per: the fitted slope, rounded; base and exec fees rounded up), so     *)
(* the tables never understate what they were measured on; "max            *)
(* residual" is the most a key overstates one measurement (Ggas).          *)
(*                                                                         *)
(* Provenance:                                                             *)
(*   sim rev          4be28150bce8a564836eafdaf4caa49e43b1dca5             *)
(*   nearcore         2.14.0 (bc4e9e8cfb03d9e82f027883055624e18576993e)    *)
(*   protocol version 88                                                   *)
(*   mt-probe.near: mt.wasm                                                *)
(*     conformance/probes/mt (near-sdk-contract-tools 4.0.0, near-sdk 5.29.1)*)
(*     sha256 fb47baf7acc9528cc9a7bcc01ce4d7a0                             *)
(*            bacdd62f8fd4e950174b857c5c2b366b                             *)
(*   mr-probe.near: mtrecv.wasm                                            *)
(*     conformance/probes/mtrecv (near-sdk 5.29.1)                         *)
(*     sha256 2488e7d43825ac92c7ccf69c3240e529                             *)
(*            2237a1587a3fc8737464fa49d72bdc3a                             *)
(* command: calibrate --flows flows/mt.toml --from-data --merge-accts mt   *)
(*     --tla tla/CalibMt.tla --prefix Mt                                   *)
(* flows: mt.toml sha256                                                   *)
(*     ec0e728c6638a3ef038de9b35cf10ff7bd7ac412383dbf3a0859857b96c39786    *)
(* grid: standard (1313 points), 19 flows                                  *)
(* split check: 30540 children, 0 mismatches; 0 per action                 *)
(*                                                                         *)
(* Burns depend on the contract's code and state: recalibrate for a real   *)
(* deployment (conformance/README.md).                                     *)
(***************************************************************************)
EXTENDS TLC, Sequences

MtGasBurn ==
    "mr.mt_on_transfer/burn20000" :> [base |-> 20091, per |-> 0] @@  \* 1 pt; spread 20.090-20.090 Tgas
    "mr.mt_on_transfer/empty" :> [base |-> 303, per |-> 0] @@  \* 1 pt; spread 0.302-0.302 Tgas
    "mr.mt_on_transfer/keep" :> [base |-> 295, per |-> 8] @@  \* 4 pts; spread 0.302-0.318 Tgas; per exact 7.8190
    "mr.mt_on_transfer/long" :> [base |-> 315, per |-> 0] @@  \* 1 pt; spread 0.314-0.314 Tgas
    "mr.mt_on_transfer/mal" :> [base |-> 304, per |-> 0] @@  \* 1 pt; spread 0.303-0.303 Tgas
    "mr.mt_on_transfer/over" :> [base |-> 311, per |-> 0] @@  \* 1 pt; spread 0.311-0.311 Tgas
    "mr.mt_on_transfer/panic" :> [base |-> 232, per |-> 0] @@  \* 1 pt; spread 0.232-0.232 Tgas; burn up to the failure (never succeeds)
    "mr.mt_on_transfer/return" :> [base |-> 294, per |-> 8] @@  \* 4 pts; spread 0.302-0.318 Tgas; per exact 7.9018
    "mr.mt_on_transfer/short" :> [base |-> 308, per |-> 0] @@  \* 1 pt; spread 0.307-0.307 Tgas
    "mt.mt_batch_transfer" :> [base |-> 497, per |-> 406] @@  \* 3 pts; spread 0.903-1.715 Tgas; per exact 406.0983
    "mt.mt_batch_transfer_call" :> [base |-> 1282, per |-> 417] @@  \* 13 pts; spread 1.697-2.532 Tgas; per exact 417.2659; max residual 1.3
    "mt.mt_resolve_transfer" :> [base |-> 1028, per |-> 354] @@  \* 15 pts; spread 0.533-2.090 Tgas; per exact 354.4558; max residual 1393.8
    "mt.mt_transfer" :> [base |-> 900, per |-> 0] @@  \* 1 pt; spread 0.899-0.899 Tgas
    "mt.mt_transfer_call" :> [base |-> 1695, per |-> 0]  \* 2 pts; spread 1.694-1.694 Tgas

MtGasCall ==
    "mr.mt_on_transfer" :> [st |-> <<0>>, wt |-> <<10>>, fee |-> 889] @@
    "mt.mt_resolve_transfer" :> [st |-> <<5000>>, wt |-> <<1>>, fee |-> 889]
