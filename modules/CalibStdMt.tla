---------------------------- MODULE CalibStdMt ----------------------------
(***************************************************************************)
(* Calibrated gas tables, generated by conformance/ (bin `calibrate`):     *)
(* do not edit by hand.  Units: Ggas (1 Tgas = 1000); burn = base + per *  *)
(* size.  Measured in near-contract-sim, which runs nearcore's             *)
(* Runtime::apply.  Every burn measured is at or below base + per * size   *)
(* (per: the fitted slope, rounded; base and exec fees rounded up), so     *)
(* the tables never understate what they were measured on; "max            *)
(* residual" is the most a key overstates one measurement (Ggas).          *)
(*                                                                         *)
(* Provenance:                                                             *)
(*   sim rev          29e909033bb59eab792dee136e9d02870488bc3e             *)
(*   nearcore         2.14.0-rc.5 (b7b4737cab46f17a6daa2ed694d7aebbd204363a)*)
(*   protocol version 88                                                   *)
(*   mt-probe.near: mt.wasm                                                *)
(*     conformance/probes/mt (near-sdk-contract-tools 4.0.0, near-sdk 5.29.1)*)
(*     sha256 fb47baf7acc9528cc9a7bcc01ce4d7a0                             *)
(*            bacdd62f8fd4e950174b857c5c2b366b                             *)
(*   mr-probe.near: mtrecv.wasm                                            *)
(*     conformance/probes/mtrecv (near-sdk 5.29.1)                         *)
(*     sha256 2488e7d43825ac92c7ccf69c3240e529                             *)
(*            2237a1587a3fc8737464fa49d72bdc3a                             *)
(* command: calibrate --flows flows/mt.toml --from-data --merge-accts mt   *)
(*     --group mt:StdMt:mt --tla ../modules/CalibStdMt.tla --module        *)
(*     CalibStdMt --notes flows/calibstdmt.notes                           *)
(* flows: mt.toml sha256                                                   *)
(*     ec0e728c6638a3ef038de9b35cf10ff7bd7ac412383dbf3a0859857b96c39786    *)
(* grid: standard (1313 points), 19 flows                                  *)
(* split check: 30540 children, 0 mismatches; 0 per action                 *)
(*                                                                         *)
(* Tables: StdMtGasBurn(mt) / StdMtGasCall(mt) for a plain                 *)
(* near-sdk-contract-tools 4.0.0 NEP-245 multi token (#[derive(Nep245)]);  *)
(* the parameter is the token's model account (measured on the probe       *)
(* account mt-probe.near, flows/mt.toml).  Use them with                   *)
(* MtGasShape[mt] = "tools" (modules/Nep245.tla): the _call methods need   *)
(* 30 Tgas prepaid (MtMinCallGas), mt_on_transfer gets static 0 and weight *)
(* 10, mt_resolve_transfer static 5 Tgas and weight 1, whatever the number *)
(* of ids.  Size = the number of ids: mt_batch_transfer,                   *)
(* mt_batch_transfer_call and mt_resolve_transfer burn base + per * ids.   *)
(* mt_resolve_transfer has no path keys: its method key is the largest     *)
(* burn seen, refunding or not, so it overstates a resolve that refunds    *)
(* nothing (by up to the max residual below); it creates no receipts, so   *)
(* no attached gas depends on it.  mt_on_transfer's burn and exec fee      *)
(* belong to the receiver's own entries, not the token's.                  *)
(* Burns depend on the contract's code and state: recalibrate for a real   *)
(* deployment (conformance/README.md).                                     *)
(***************************************************************************)
EXTENDS TLC, Sequences

StdMtGasBurn(mt) ==
    mt \o ".mt_batch_transfer" :> [base |-> 497, per |-> 406] @@  \* 3 pts; spread 0.903-1.715 Tgas; per exact 406.0983
    mt \o ".mt_batch_transfer_call" :> [base |-> 1282, per |-> 417] @@  \* 13 pts; spread 1.697-2.532 Tgas; per exact 417.2659; max residual 1.3
    mt \o ".mt_resolve_transfer" :> [base |-> 1028, per |-> 354] @@  \* 15 pts; spread 0.533-2.090 Tgas; per exact 354.4558; max residual 1393.8
    mt \o ".mt_transfer" :> [base |-> 900, per |-> 0] @@  \* 1 pt; spread 0.899-0.899 Tgas
    mt \o ".mt_transfer_call" :> [base |-> 1695, per |-> 0]  \* 2 pts; spread 1.694-1.694 Tgas

StdMtGasCall(mt) ==
    mt \o ".mt_resolve_transfer" :> [st |-> <<5000>>, wt |-> <<1>>, fee |-> 889]
=============================================================================
